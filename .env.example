# Local development (pnpm dev, pnpm db:migrate, pnpm live:migrate): one Postgres from infra/compose.dev.yaml.
DATABASE_URL=postgres://ryde:local-development-only@127.0.0.1:5432/ryde
POSTGRES_PASSWORD=local-development-only
RELEASE_SHA=local

# The site stack (infra/compose.yaml with infra/compose.fishbowl.yaml). Docker Compose reads these from the shell or from a
# file passed with --env-file; it refuses to start while any of the three below is empty. Make each token with: openssl rand -hex 32
# The live tables' own database password.
FISHBOWL_DB_PASSWORD=
# The operator token. Caddy adds it to each request after the site login, so a browser never holds it. A local run without
# Caddy (next start with FISHBOWL_SITE_AUTH unset) asks for it once on the page instead.
FISHBOWL_CONTROL_TOKEN=
# The read-only token for the public copy. It must differ from the operator token.
FISHBOWL_VIEW_TOKEN=

# With infra/compose.viewer.yaml (Caddy with the site login) also set RYDE_SITE_HOST, RYDE_SITE_USER, RYDE_SITE_PASSWORD_HASH
# (from `caddy hash-password`), AGENT_LAB_VIEW_TOKEN and AGENT_LAB_RUNS_HOST.
# Model keys are never read from this file: infra/compose.gateway.yaml reads them from root-only files under /etc/ryde (see its header).
